AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT_MS=30000
AI_MAX_REQUESTS_PER_MINUTE=10
# NVIDIA alternative: AI_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA alternative: AI_MODEL=meta/llama-3.3-70b-instruct
# For NVIDIA, set AI_API_KEY to the NVIDIA key. Keep .env.local outside Git.
